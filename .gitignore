import java.util.Scanner;

public class CompetitiveExamReportCard {

    // Helper class to store and calculate statistics for each subject
    static class SubjectStats {
        String name;
        int totalQuestions;
        int maxMarks;
        int rightAnswers;
        int wrongAnswers;
        int notAttempted;
        double marksPerQuestion;
        double negativeMarkWeight; // e.g., 0.33 for 1/3rd negative marking

        public SubjectStats(String name, int totalQuestions, int maxMarks, double negativeMarkWeight) {
            this.name = name;
            this.totalQuestions = totalQuestions;
            this.maxMarks = maxMarks;
            this.marksPerQuestion = (double) maxMarks / totalQuestions;
            this.negativeMarkWeight = negativeMarkWeight;
        }

        public void setInputs(int right, int wrong, int notAttempted) {
            this.rightAnswers = right;
            this.wrongAnswers = wrong;
            this.notAttempted = notAttempted;
        }

        public int getAttempted() {
            return rightAnswers + wrongAnswers;
        }

        public double getScoredMarks() {
            double positiveScore = rightAnswers * marksPerQuestion;
            double negativeScore = wrongAnswers * (marksPerQuestion * negativeMarkWeight);
            double finalScore = positiveScore - negativeScore;
            return Math.max(0.0, finalScore); // Ensure marks don't drop below zero overall
        }

        public double getPercentage() {
            if (maxMarks == 0) return 0.0;
            return (getScoredMarks() / maxMarks) * 100.0;
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("==================================================");
        System.out.println("   RRB / SSC / STATE EXAM PERFORMANCE EVALUATOR   ");
        System.out.println("==================================================");
        
        // Define standard exam pattern structures (Adjustable)
        // Format: Subject Name, Total Questions, Total Max Marks, Negative Marking Ratio (e.g., 0.33 for 1/3rd)
        SubjectStats arithmetic = new SubjectStats("Arithmetic / Quant", 25, 25, 0.33);
        SubjectStats reasoning = new SubjectStats("General Intelligence & Reasoning", 25, 25, 0.33);
        SubjectStats english = new SubjectStats("English Language", 25, 25, 0.33);
        SubjectStats gk = new SubjectStats("General Knowledge & GA", 25, 25, 0.33);

        SubjectStats[] subjects = {arithmetic, reasoning, english, gk};

        System.out.println("\nEnter your exam results data section-by-section:\n");

        // Input loop for each section
        for (SubjectStats subj : subjects) {
            System.out.println("--- " + subj.name + " (" + subj.totalQuestions + " Questions, " + subj.maxMarks + " Marks) ---");
            
            int right = -1, wrong = -1, notAttempted = -1;
            
            while (true) {
                System.out.print("Enter Right Answers (0 - " + subj.totalQuestions + "): ");
                right = scanner.nextInt();
                
                System.out.print("Enter Wrong Answers: ");
                wrong = scanner.nextInt();
                
                notAttempted = subj.totalQuestions - (right + wrong);
                
                if (right >= 0 && wrong >= 0 && notAttempted >= 0 && (right + wrong <= subj.totalQuestions)) {
                    break;
                }
                System.out.println("⚠️ Invalid entry! Sum of right and wrong cannot exceed total questions. Re-enter.\n");
            }
            
            subj.setInputs(right, wrong, notAttempted);
            System.out.println("-> Not Attempted calculated automatically: " + notAttempted + "\n");
        }

        scanner.close();

        // ==========================================
        // GENERATE FINAL DETAILED REPORT CARD
        // ==========================================
        System.out.println("\n================================================================");
        System.out.println("                     FINAL EXAM REPORT CARD                     ");
        System.out.println("================================================================");
        System.out.printf("%-35s | %-8s | %-8s | %-8s | %-8s\n", "Subject", "Attempt", "Right", "Wrong", "Score");
        System.out.println("--------------------------------------------------------------------------------");

        int totalQ = 0, totalAtt = 0, totalRight = 0, totalWrong = 0, totalNotAtt = 0;
        double totalMaxMarks = 0, totalScoredMarks = 0;

        for (SubjectStats subj : subjects) {
            int attempted = subj.getAttempted();
            double scored = subj.getScoredMarks();
            
            System.out.printf("%-35s | %-8d | %-8d | %-8d | %6.2f/%d\n", 
                subj.name, attempted, subj.rightAnswers, subj.wrongAnswers, scored, subj.maxMarks);

            // Accumulate totals
            totalQ += subj.totalQuestions;
            totalAtt += attempted;
            totalRight += subj.rightAnswers;
            totalWrong += subj.wrongAnswers;
            totalNotAtt += subj.notAttempted;
            totalMaxMarks += subj.maxMarks;
            totalScoredMarks += scored;
        }

        double overallPercentage = (totalScoredMarks / totalMaxMarks) * 100.0;

        System.out.println("================================================================");
        System.out.println("                     OVERALL PERFORMANCE SUMMARY                ");
        System.out.println("================================================================");
        System.out.printf(" Total Questions in Exam : %d\n", totalQ);
        System.out.printf(" Total Questions Attempted: %d\n", totalAtt);
        System.out.printf(" Total Questions Skipped : %d\n", totalNotAtt);
        System.out.printf(" Total Correct Answers   : %d\n", totalRight);
        System.out.printf(" Total Incorrect Answers : %d\n", totalWrong);
        System.out.println("----------------------------------------------------------------");
        System.out.printf("🎯 **Final Marks Scored**  : %.2f / %.0f\n", totalScoredMarks, totalMaxMarks);
        System.out.printf("📈 **Overall Percentage**  : %.2f%%\n", overallPercentage);
        
        // Performance grading benchmark
        if (overallPercentage >= 80.0) {
            System.out.println("🏆 **Grade / Standing**: Outstanding! Safe for top-tier competitive cutoffs.");
        } else if (overallPercentage >= 65.0) {
            System.out.println("⭐ **Grade / Standing**: Good Performance. Highly competitive score.");
        } else if (overallPercentage >= 50.0) {
            System.out.println("⚠️ **Grade / Standing**: Average Standing. Focus on reducing negative marking.");
        } else {
            System.out.println("❌ **Grade / Standing**: Needs Improvement. Comprehensive revision required.");
        }
        System.out.println("================================================================");
    }
}